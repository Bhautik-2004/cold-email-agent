{
  "name": "cold-email-agent",
  "version": "0.1.0",
  "description": "Finds cold emails with no reply after N days and drafts a follow-up in Gmail with Claude, using your second brain for context.",
  "scripts": {
    "start": "node --no-deprecation --import tsx src/index.ts",
    "draft": "node --no-deprecation --import tsx src/index.ts --draft",
    "test-run": "node --no-deprecation --import tsx src/index.ts --days 0 --limit 3",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "googleapis": "^190.0.0",
    "groq-sdk": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
